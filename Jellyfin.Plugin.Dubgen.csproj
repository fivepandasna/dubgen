<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Dubgen</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Dubgen</AssemblyName>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep these in step with the Jellyfin server version you target (see targetAbi in build.yaml). -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.5" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.5" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Served by Plugin.GetPages() as the plugin's settings page. -->
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
